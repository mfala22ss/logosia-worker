{
  "name": "logosia-worker",
  "version": "1.0.0",
  "private": true,
  "description": "News ingestion + scoring pipeline for logosia.com.au — scrapes RSS, scores bias/importance, translates and summarises into Supabase.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "worker:once": "node worker/index.js --once",
    "worker:scrape": "node worker/index.js",
    "db:seed-sources": "node worker/scripts/seed-sources.js",
    "scrape": "node -e \"const {scrape}=require('./worker/scraper.js');scrape().then(r=>console.log('[scrape done]',r)).catch(e=>{console.error(e);process.exit(1)})\"",
    "categorize": "node -e \"const {run}=require('./worker/agents/categorizer.js');run().then(r=>console.log('[categorize done]',r)).catch(e=>{console.error(e);process.exit(1)})\"",
    "curate": "node -e \"const {run}=require('./worker/agents/curator.js');run().then(r=>console.log('[curate done]',r)).catch(e=>{console.error(e);process.exit(1)})\"",
    "cluster": "node -e \"const {run}=require('./worker/agents/clusterer.js');run().then(r=>console.log('[cluster done]',r)).catch(e=>{console.error(e);process.exit(1)})\"",
    "retain": "node -e \"const {run}=require('./worker/agents/retainer.js');run().then(r=>console.log('[retain done]',r)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@supabase/supabase-js": "^2.46.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.18.0",
    "rss-parser": "^3.13.0"
  }
}
