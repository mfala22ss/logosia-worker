# ───────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.
# ───────────────────────────────────────────────────────────

# ─── Supabase ──────────────────────────────────────────────
# Dashboard → Project Settings → API
# The worker writes to the DB, so it needs the service role key.
# This key bypasses RLS — it must never reach a browser bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── AI (Groq — free tier, generous limits) ────────────────
# https://console.groq.com/keys
# Keys 2 and 3 are optional; ai.js rotates across whichever are set.
GROQ_KEY=gsk_...
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Runtime ───────────────────────────────────────────────
# Loop interval when running `npm run worker:scrape` (ignored with --once).
SCRAPE_INTERVAL_MIN=30

# Where transformers.js caches the ~110MB embedding model.
HF_CACHE_DIR=./.cache/transformers

# ─── Retention ─────────────────────────────────────────────
# The only thing standing between this project and a repeat of the 2026-07-20
# disk-full outage. Both are FLOORS: the retainer tightens automatically when the
# volume gets full (see DISK_* below), so raising them raises the ceiling, not the
# guarantee. Whether 3d/14d actually fits in 500MB has never been measured.
PRUNE_AFTER_DAYS=3
DELETE_AFTER_DAYS=14

# How long worker_runs history is kept. Purely observability — trim freely.
WORKER_RUNS_RETAIN_DAYS=30

# ─── Disk-headroom guard ───────────────────────────────────
# Free tier is 500MB and exposes no disk-resize endpoint. Raise DISK_LIMIT_BYTES
# only after actually upgrading the plan — overstating it disarms the guard.
DISK_LIMIT_BYTES=524288000
# Above SOFT the retainer halves both windows for that run; above HARD it drops to
# the emergency minimums (1d/3d). Recovery is automatic once usage falls.
DISK_SOFT_PCT=70
DISK_HARD_PCT=85

# ─── Source auto-disable ───────────────────────────────────
# CONSECUTIVE failures before a feed is retired (~16h at 12 runs/day). Any success
# resets the counter. Premium and tier-1 sources are never auto-disabled.
SOURCE_FAILURE_THRESHOLD=8
# If more than this many feeds cross the threshold in one run, that is an
# infrastructure fault, not N dead feeds — nothing is disabled and it alerts.
MAX_DISABLES_PER_RUN=10

# ─── Watchdog ──────────────────────────────────────────────
# The public site, checked from outside. Stays valid when Supabase is down.
SITE_URL=https://logosia.com.au
# Minutes without a fully-successful run before alerting.
WATCHDOG_MAX_MINUTES=90
# Minutes without ANY run before alerting. Much wider, and a different question:
# it catches the SCHEDULER dying — e.g. GitHub disabling the cron for repository
# inactivity, which produces no failure and no red run.
WATCHDOG_MAX_SILENCE=240
# Minimum articles ingested per window. Green runs that ingest nothing are the
# failure mode that preceded the outage.
WATCHDOG_MIN_ARTICLES=1
WATCHDOG_ARTICLE_HOURS=3
WATCHDOG_DISK_PCT=80

# ─── Alert channels (set at least ONE) ─────────────────────
# With none configured the watchdog can detect an outage and have nowhere to say
# so — which is exactly the 2026-07-20 situation it exists to prevent.
#
# ntfy: no account needed. The topic IS the credential, so make it unguessable —
# anyone who knows the name can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram: create a bot with @BotFather, then message it and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=
